rules_version = '2';

// Pottery Challenges. Access is by allowlist document, never by hardcoded emails.
// To add a person: create allowlist/{their lowercase gmail} with { role: 'member' }.
// The first admin is created from the Firebase console (console writes bypass rules).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function myAllowEntry() {
      return get(/databases/$(database)/documents/allowlist/$(myEmail())).data;
    }
    function allowlisted() {
      return signedIn() && exists(/databases/$(database)/documents/allowlist/$(myEmail()));
    }
    function isAdmin() {
      return allowlisted() && myAllowEntry().role == 'admin';
    }
    function isMe(uid) {
      return allowlisted() && request.auth.uid == uid;
    }

    // ---------- access + config ----------
    match /allowlist/{email} {
      allow read: if isAdmin() || (signedIn() && myEmail() == email);
      allow write: if isAdmin();
    }
    match /config/{doc} {
      allow read: if allowlisted();
      allow write: if isAdmin();
    }
    match /meta/{doc} {
      allow read, write: if isAdmin();
    }

    // ---------- shared challenge library ----------
    // Members read approved challenges only. Admins read everything and can approve,
    // reject or retire. Nobody creates or deletes from the app: the import is done with
    // the Admin SDK, which bypasses these rules.
    match /challenges/{id} {
      allow read: if allowlisted() && (resource.data.status == 'approved' || isAdmin());
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    // ---------- per-user data ----------
    // Each subcollection is listed on purpose. A recursive wildcard here would also open
    // up events (append-only) and remixes (written by the function only).
    match /users/{uid} {
      allow read, write: if isMe(uid);

      match /challengeState/{id} {
        allow read, write: if isMe(uid);
      }

      match /projects/{id} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid) && validProject(request.resource.data);
      }

      match /kilnBatches/{id} {
        allow read, write: if isMe(uid);
      }

      // Photos stay private in the MVP. Public sharing is a later feature and will be
      // written by a function, not by the client.
      match /photos/{id} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid) && request.resource.data.visibility == 'private';
      }

      // Activity log: add-only, so streaks and badges can be trusted later.
      match /events/{id} {
        allow read: if isMe(uid);
        allow create: if isMe(uid);
        allow update, delete: if false;
      }

      // Challenges made with Create or Remix. Only the Cloud Function writes them (as drafts).
      // The person can keep a draft by changing its status to 'saved' and nothing else, so the
      // content the function produced, and checked, can never be edited from the app.
      match /remixes/{id} {
        allow read, delete: if isMe(uid);
        allow create: if false;
        allow update: if isMe(uid)
          && resource.data.status == 'draft'
          && request.resource.data.status == 'saved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'savedAt']);
      }
    }

    function validProject(d) {
      return d.stage in ['planned', 'made', 'drying', 'bisque-ready', 'bisque-fired',
                         'glazed', 'glaze-fired', 'done']
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 4000));
    }

    // ---------- usage counters (written by functions only) ----------
    match /usage/{uid}/days/{day} {
      allow read: if isMe(uid);
      allow write: if false;
    }
    match /usageGlobal/{month} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- public share projections (built later; functions write them) ----------
    match /publicChallenges/{number} {
      allow read: if true;
      allow write: if false;
    }
    match /publicPhotos/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
